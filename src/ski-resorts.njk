      <a class="post-card-link" href="{{ resort.url }}">
        {% if resort.data.hero %}
          {% thumb resort.data.hero, resort.data.title, "(max-width: 700px) 90vw, 22rem", "post-card-img" %}
        {% endif %}
        <h2 class="post-card-title">{{ resort.data.title }}</h2>
      </a>
      {% if resort.data.summary %}<p class="post-card-summary">{{ resort.data.summary }}</p>{% endif %}
    </article>
  {% endfor %}
</section>
